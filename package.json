{
    "name": "ry-wc-city-select",
    "title": "RY Tools for WooCommerce",
    "version": "2.2.0",
    "author": "Richer Yang",
    "private": true,
    "devDependencies": {
        "@wordpress/i18n": "^6.21.0",
        "@wordpress/scripts": "^32.4.0"
    },
    "scripts": {
        "start": "wp-scripts start",
        "build": "npm run build:assets && npm run i18n:pot",
        "build:all": "npm run build:assets && npm run build:i18n",
        "build:assets": "wp-scripts build",
        "build:i18n": "npm run i18n:pot",
        "i18n:pot": "wp i18n make-pot \"\" \"languages/ry-wc-city-select.pot\" --slug=\"ry-wc-city-select\" --domain=\"ry-wc-city-select\" --exclude=\"node_modules,assets-src\"",
        "update": "npm update"
    }
}
